+    /// Rebuild script-derived indexes produced by versions without replay isolation.
+    /// Preserve headers, proofs, fetched transactions and subscription identities.
+    /// Call at startup before network workers can write to this storage.
+    fn rebuild_legacy_script_indexes(&self) -> crate::error::Result<bool> {
+        let version_key = Key::Meta("SCRIPT_INDEX_REPLAY_VERSION").into_vec();
+        if StorageBackend::get(self, version_key.clone())?.as_deref() == Some(&[1]) {
+            return Ok(false);
+        }
+        let scripts = self.get_filter_scripts();
+        let mut batch = self.batch();
+        for prefix in [
+            KeyPrefix::CellLockScript as u8,
+            KeyPrefix::CellTypeScript as u8,
+            KeyPrefix::TxLockScript as u8,
+            KeyPrefix::TxTypeScript as u8,
+        ] {
+            let rows = self.try_collect_iterator(
+                IteratorStart::From(vec![prefix]),
+                IteratorDirection::Forward,
+                Box::new(move |key| key.first() == Some(&prefix)),
+                Box::new(|_, _| Some(Vec::new())),
+                usize::MAX,
+            )?;
+            for row in rows {
+                batch.delete(&row.key);
+            }
+        }
+        let matched_prefix = Key::Meta(MATCHED_FILTER_BLOCKS_KEY).into_vec();
+        let rows = self.try_collect_iterator(
+            IteratorStart::From(matched_prefix.clone()),
+            IteratorDirection::Forward,
+            Box::new(move |key| key.starts_with(&matched_prefix)),
+            Box::new(|_, _| Some(Vec::new())),
+            usize::MAX,
+        )?;
+        for row in rows {
+            batch.delete(&row.key);
+        }
+        for status in &scripts {
+            let key = [
+                Key::Meta(FILTER_SCRIPTS_KEY).into_vec(),
+                status.script.as_slice().to_vec(),
+                vec![match status.script_type {
+                    ScriptType::Lock => 0,
+                    ScriptType::Type => 1,
+                }],
+            ]
+            .concat();
+            batch.put(&key, &0u64.to_be_bytes());
+        }
+        batch.put(
+            &Key::Meta(MIN_FILTERED_BLOCK_NUMBER).into_vec(),
+            &0u64.to_le_bytes(),
+        );
+        batch.commit()?;
+        // Mark complete only after genesis replay; interrupted repairs retry safely.
+        if !scripts.is_empty() {
+            self.filter_block(self.get_genesis_block());
+        }
+        self.put(version_key, vec![1])?;
+        Ok(true)
+    }
