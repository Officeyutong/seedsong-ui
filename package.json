{
  "name": "seedsong-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts test",
    "preview": "vite preview",
    "setup": "node scripts/setup.mjs",
    "test": "tsx --test test/protocol.test.ts",
    "test:browser": "playwright test --headed",
    "format": "prettier --write src scripts test playwright.config.ts vite.config.ts",
    "format:check": "prettier --check src scripts test playwright.config.ts vite.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@mui/material": "^9.5.0",
    "@mui/icons-material": "^9.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "seedsong-js": "file:vendor/seedsong-base/wasm/seedsong-js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
